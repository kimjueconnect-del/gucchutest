# ============================================================
# Gucchu Test — Supabase Configuration (EXAMPLE)
# ============================================================
# Copy this file to .env.local and fill in your Supabase credentials.
# Then update prisma/schema.prisma datasource provider to "postgresql".
# See README.md → "Switching to Supabase" for the full guide.
# ============================================================

# ---- Database (Supabase Postgres) ----
# From Supabase Dashboard → Settings → Database → Connection string (URI)
# IMPORTANT: keep ?pgbouncer=true&connection_limit=1 for serverless compatibility
DATABASE_URL="postgresql://postgres.<your-project-ref>:<your-password>@db.<your-project-ref>.supabase.co:5432/postgres?pgbouncer=true&connection_limit=1"

# Direct connection (for Prisma migrations — bypasses PgBouncer)
# Use this if `bun run db:push` fails with the pooled connection
DIRECT_URL="postgresql://postgres.<your-project-ref>:<your-password>@db.<your-project-ref>.supabase.co:5432/postgres"

# ---- Supabase API Keys ----
# From Supabase Dashboard → Settings → API
SUPABASE_URL="https://<your-project-ref>.supabase.co"
SUPABASE_ANON_KEY="<your-anon-public-key>"
SUPABASE_SERVICE_ROLE_KEY="<your-service-role-secret-key>"

# ---- Auth ----
# Generate a strong random string: openssl rand -base64 32
JWT_SECRET="<replace-with-a-strong-32+-char-random-string>"

# ---- App ----
NODE_ENV="production"
